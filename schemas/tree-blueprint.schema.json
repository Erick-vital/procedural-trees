{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "TreeBlueprint v1: receta de datos; resolución sin ejecución",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "id",
    "version",
    "name",
    "description",
    "components",
    "parameters",
    "appearance",
    "editable_ranges",
    "default_profile",
    "profiles",
    "limits"
  ],
  "properties": {
    "schema_version": {
      "const": "1.0"
    },
    "id": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9_]{0,63}$"
    },
    "version": {
      "type": "string",
      "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$",
      "maxLength": 32
    },
    "name": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128
    },
    "description": {
      "type": "string",
      "maxLength": 1024
    },
    "components": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "base",
        "distribution",
        "representation"
      ],
      "properties": {
        "base": {
          "type": "string",
          "minLength": 1,
          "maxLength": 96
        },
        "distribution": {
          "type": "string",
          "minLength": 1,
          "maxLength": 96
        },
        "representation": {
          "type": "string",
          "minLength": 1,
          "maxLength": 96
        }
      }
    },
    "parameters": {
      "$ref": "#/$defs/parameters"
    },
    "appearance": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "bark",
        "leaf"
      ],
      "properties": {
        "bark": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "color_rgba",
            "roughness",
            "metallic",
            "double_sided"
          ],
          "properties": {
            "color_rgba": {
              "type": "array",
              "minItems": 4,
              "maxItems": 4,
              "prefixItems": [
                {
                  "type": "number",
                  "minimum": 0,
                  "maximum": 1
                },
                {
                  "type": "number",
                  "minimum": 0,
                  "maximum": 1
                },
                {
                  "type": "number",
                  "minimum": 0,
                  "maximum": 1
                },
                {
                  "const": 1
                }
              ],
              "items": false
            },
            "roughness": {
              "type": "number",
              "minimum": 0,
              "maximum": 1
            },
            "metallic": {
              "type": "number",
              "minimum": 0,
              "maximum": 1
            },
            "double_sided": {
              "const": true
            }
          }
        },
        "leaf": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "color_rgba",
            "roughness",
            "metallic",
            "double_sided"
          ],
          "properties": {
            "color_rgba": {
              "type": "array",
              "minItems": 4,
              "maxItems": 4,
              "prefixItems": [
                {
                  "type": "number",
                  "minimum": 0,
                  "maximum": 1
                },
                {
                  "type": "number",
                  "minimum": 0,
                  "maximum": 1
                },
                {
                  "type": "number",
                  "minimum": 0,
                  "maximum": 1
                },
                {
                  "const": 1
                }
              ],
              "items": false
            },
            "roughness": {
              "type": "number",
              "minimum": 0,
              "maximum": 1
            },
            "metallic": {
              "type": "number",
              "minimum": 0,
              "maximum": 1
            },
            "double_sided": {
              "const": true
            }
          }
        }
      }
    },
    "editable_ranges": {
      "type": "object",
      "maxProperties": 21,
      "propertyNames": {
        "enum": [
          "base.height_m",
          "base.base_radius_m",
          "base.curvature",
          "base.primary_branches",
          "base.max_depth",
          "base.branch_length_ratio",
          "base.inclination_deg",
          "base.asymmetry",
          "base.foliage_density",
          "base.foliage_scale_m",
          "canopy.group_count",
          "canopy.leaf_length_m",
          "canopy.shell_depth_m",
          "canopy.twig_radius_m",
          "canopy.tip_radius_ratio",
          "canopy.profile_width_scale",
          "canopy.region_weights.north",
          "canopy.region_weights.east",
          "canopy.region_weights.south",
          "canopy.region_weights.west",
          "canopy.layout_leaf_length_m"
        ]
      },
      "additionalProperties": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "minimum",
          "maximum"
        ],
        "properties": {
          "minimum": {
            "type": "number"
          },
          "maximum": {
            "type": "number"
          }
        }
      }
    },
    "default_profile": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9_]{0,63}$"
    },
    "profiles": {
      "type": "object",
      "minProperties": 1,
      "maxProperties": 16,
      "propertyNames": {
        "pattern": "^[a-z][a-z0-9_]{0,63}$"
      },
      "additionalProperties": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "description",
          "overrides",
          "validation"
        ],
        "properties": {
          "description": {
            "type": "string",
            "maxLength": 512
          },
          "overrides": {
            "$ref": "#/$defs/overrides"
          },
          "validation": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "status",
              "evidence"
            ],
            "properties": {
              "status": {
                "enum": [
                  "reference_only",
                  "experimental",
                  "verified_cases"
                ]
              },
              "evidence": {
                "type": "array",
                "minItems": 1,
                "maxItems": 16,
                "uniqueItems": true,
                "items": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 256
                }
              }
            }
          }
        }
      }
    },
    "limits": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "triangles",
        "materials",
        "generation_seconds"
      ],
      "properties": {
        "triangles": {
          "type": "integer",
          "minimum": 1,
          "maximum": 12500
        },
        "materials": {
          "type": "integer",
          "minimum": 1,
          "maximum": 3
        },
        "generation_seconds": {
          "type": "number",
          "exclusiveMinimum": 0,
          "maximum": 120
        }
      }
    }
  },
  "$defs": {
    "parameters": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "base",
        "canopy"
      ],
      "properties": {
        "base": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "height_m",
            "base_radius_m",
            "curvature",
            "primary_branches",
            "max_depth",
            "branch_length_ratio",
            "inclination_deg",
            "asymmetry",
            "foliage_density",
            "foliage_scale_m"
          ],
          "properties": {
            "height_m": {
              "type": "number",
              "minimum": 2,
              "maximum": 20
            },
            "base_radius_m": {
              "type": "number",
              "minimum": 0.05,
              "maximum": 1
            },
            "curvature": {
              "type": "number",
              "minimum": 0,
              "maximum": 0.3,
              "description": "Desplazamiento lateral relativo a altura"
            },
            "primary_branches": {
              "type": "integer",
              "minimum": 1,
              "maximum": 12
            },
            "max_depth": {
              "type": "integer",
              "minimum": 1,
              "maximum": 2
            },
            "branch_length_ratio": {
              "type": "number",
              "minimum": 0.1,
              "maximum": 0.6
            },
            "inclination_deg": {
              "type": "number",
              "minimum": 10,
              "maximum": 80,
              "description": "Ángulo desde la vertical"
            },
            "asymmetry": {
              "type": "number",
              "minimum": 0,
              "maximum": 1
            },
            "foliage_density": {
              "type": "number",
              "minimum": 0,
              "maximum": 1,
              "description": "0.1/0.2: masas por extremo; 0.3: por tramo distal; 0.4: control de cantidad por longitud/nivel (máximos tronco/primaria/secundaria 2/3/2); 0 sin follaje; 0.4.1: cantidad por longitud y radio, con secundarias intermedias sin hojas"
            },
            "foliage_scale_m": {
              "type": "number",
              "minimum": 0.2,
              "maximum": 3
            }
          }
        },
        "canopy": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "group_count",
            "leaf_length_m",
            "shell_depth_m",
            "twig_radius_m",
            "tip_radius_ratio",
            "profile_width_scale",
            "region_weights",
            "layout_leaf_length_m"
          ],
          "properties": {
            "group_count": {
              "type": "integer",
              "minimum": 24,
              "maximum": 360
            },
            "leaf_length_m": {
              "type": "number",
              "minimum": 0.2,
              "maximum": 1
            },
            "shell_depth_m": {
              "type": "number",
              "minimum": 0.02,
              "maximum": 0.3
            },
            "twig_radius_m": {
              "type": "number",
              "minimum": 0.008,
              "maximum": 0.03
            },
            "tip_radius_ratio": {
              "type": "number",
              "minimum": 0.2,
              "maximum": 0.5
            },
            "profile_width_scale": {
              "type": "number",
              "minimum": 0.85,
              "maximum": 1.15
            },
            "region_weights": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "north",
                "east",
                "south",
                "west"
              ],
              "properties": {
                "north": {
                  "type": "number",
                  "minimum": 0,
                  "maximum": 1
                },
                "east": {
                  "type": "number",
                  "minimum": 0,
                  "maximum": 1
                },
                "south": {
                  "type": "number",
                  "minimum": 0,
                  "maximum": 1
                },
                "west": {
                  "type": "number",
                  "minimum": 0,
                  "maximum": 1
                }
              }
            },
            "layout_leaf_length_m": {
              "type": "number",
              "minimum": 0.2,
              "maximum": 1,
              "description": "Escala de planificación de soportes, separada de la representación."
            }
          }
        }
      }
    },
    "overrides": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "base": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "height_m": {
              "type": "number",
              "minimum": 2,
              "maximum": 20
            },
            "base_radius_m": {
              "type": "number",
              "minimum": 0.05,
              "maximum": 1
            },
            "curvature": {
              "type": "number",
              "minimum": 0,
              "maximum": 0.3,
              "description": "Desplazamiento lateral relativo a altura"
            },
            "primary_branches": {
              "type": "integer",
              "minimum": 1,
              "maximum": 12
            },
            "max_depth": {
              "type": "integer",
              "minimum": 1,
              "maximum": 2
            },
            "branch_length_ratio": {
              "type": "number",
              "minimum": 0.1,
              "maximum": 0.6
            },
            "inclination_deg": {
              "type": "number",
              "minimum": 10,
              "maximum": 80,
              "description": "Ángulo desde la vertical"
            },
            "asymmetry": {
              "type": "number",
              "minimum": 0,
              "maximum": 1
            },
            "foliage_density": {
              "type": "number",
              "minimum": 0,
              "maximum": 1,
              "description": "0.1/0.2: masas por extremo; 0.3: por tramo distal; 0.4: control de cantidad por longitud/nivel (máximos tronco/primaria/secundaria 2/3/2); 0 sin follaje; 0.4.1: cantidad por longitud y radio, con secundarias intermedias sin hojas"
            },
            "foliage_scale_m": {
              "type": "number",
              "minimum": 0.2,
              "maximum": 3
            }
          }
        },
        "canopy": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "group_count": {
              "type": "integer",
              "minimum": 24,
              "maximum": 360
            },
            "leaf_length_m": {
              "type": "number",
              "minimum": 0.2,
              "maximum": 1
            },
            "shell_depth_m": {
              "type": "number",
              "minimum": 0.02,
              "maximum": 0.3
            },
            "twig_radius_m": {
              "type": "number",
              "minimum": 0.008,
              "maximum": 0.03
            },
            "tip_radius_ratio": {
              "type": "number",
              "minimum": 0.2,
              "maximum": 0.5
            },
            "profile_width_scale": {
              "type": "number",
              "minimum": 0.85,
              "maximum": 1.15
            },
            "region_weights": {
              "type": "object",
              "additionalProperties": false,
              "properties": {
                "north": {
                  "type": "number",
                  "minimum": 0,
                  "maximum": 1
                },
                "east": {
                  "type": "number",
                  "minimum": 0,
                  "maximum": 1
                },
                "south": {
                  "type": "number",
                  "minimum": 0,
                  "maximum": 1
                },
                "west": {
                  "type": "number",
                  "minimum": 0,
                  "maximum": 1
                }
              }
            },
            "layout_leaf_length_m": {
              "type": "number",
              "minimum": 0.2,
              "maximum": 1,
              "description": "Escala de planificación de soportes, separada de la representación."
            }
          }
        }
      }
    }
  }
}
