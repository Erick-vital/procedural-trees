{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "TreeBlueprint 1.5: abedul pintado optimizado",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "id",
    "version",
    "name",
    "description",
    "components",
    "parameters",
    "appearance",
    "editable_ranges",
    "default_profile",
    "profiles",
    "limits",
    "resources"
  ],
  "properties": {
    "schema_version": {
      "const": "1.5"
    },
    "id": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9_]{0,63}$"
    },
    "version": {
      "type": "string",
      "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$",
      "maxLength": 32
    },
    "name": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128
    },
    "description": {
      "type": "string",
      "maxLength": 1024
    },
    "components": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "base",
        "distribution",
        "representation"
      ],
      "properties": {
        "base": {
          "const": "birch-crown@0.1.0"
        },
        "distribution": {
          "const": "birch-twig-groups@0.1.0"
        },
        "representation": {
          "const": "birch-painted-crossed@0.1.0"
        }
      }
    },
    "parameters": {
      "$ref": "#/$defs/parameters"
    },
    "appearance": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "bark",
        "leaf"
      ],
      "properties": {
        "bark": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "color_rgba",
            "roughness",
            "metallic",
            "double_sided"
          ],
          "properties": {
            "color_rgba": {
              "type": "array",
              "minItems": 4,
              "maxItems": 4,
              "prefixItems": [
                {
                  "const": 1
                },
                {
                  "const": 1
                },
                {
                  "const": 1
                },
                {
                  "const": 1
                }
              ],
              "items": false
            },
            "roughness": {
              "type": "number",
              "const": 0.95
            },
            "metallic": {
              "type": "number",
              "const": 0
            },
            "double_sided": {
              "const": true
            }
          }
        },
        "leaf": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "color_rgba",
            "roughness",
            "metallic",
            "double_sided"
          ],
          "properties": {
            "color_rgba": {
              "type": "array",
              "minItems": 4,
              "maxItems": 4,
              "prefixItems": [
                {
                  "const": 1
                },
                {
                  "const": 1
                },
                {
                  "const": 1
                },
                {
                  "const": 1
                }
              ],
              "items": false
            },
            "roughness": {
              "type": "number",
              "const": 0.95
            },
            "metallic": {
              "type": "number",
              "const": 0
            },
            "double_sided": {
              "const": true
            }
          }
        }
      }
    },
    "editable_ranges": {
      "type": "object",
      "maxProperties": 0
    },
    "default_profile": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9_]{0,63}$"
    },
    "profiles": {
      "type": "object",
      "minProperties": 1,
      "maxProperties": 16,
      "propertyNames": {
        "pattern": "^[a-z][a-z0-9_]{0,63}$"
      },
      "additionalProperties": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "description",
          "overrides",
          "validation"
        ],
        "properties": {
          "description": {
            "type": "string",
            "maxLength": 512
          },
          "overrides": {
            "$ref": "#/$defs/overrides"
          },
          "validation": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "status",
              "evidence"
            ],
            "properties": {
              "status": {
                "enum": [
                  "reference_only",
                  "experimental",
                  "verified_cases"
                ]
              },
              "evidence": {
                "type": "array",
                "minItems": 1,
                "maxItems": 16,
                "uniqueItems": true,
                "items": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 256
                }
              }
            }
          }
        }
      }
    },
    "limits": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "triangles",
        "materials",
        "generation_seconds"
      ],
      "properties": {
        "triangles": {
          "type": "integer",
          "minimum": 1,
          "maximum": 6999
        },
        "materials": {
          "type": "integer",
          "const": 2
        },
        "generation_seconds": {
          "type": "number",
          "exclusiveMinimum": 0,
          "maximum": 120
        }
      }
    },
    "resources": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "bark": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "path": {
              "const": "assets/abedul-pintado/v0.1.0/bark.png"
            },
            "sha256": {
              "type": "string",
              "pattern": "^[a-f0-9]{64}$"
            }
          },
          "required": [
            "path",
            "sha256"
          ]
        },
        "foliage": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "path": {
              "const": "assets/abedul-pintado/v0.1.0/foliage.png"
            },
            "sha256": {
              "type": "string",
              "pattern": "^[a-f0-9]{64}$"
            }
          },
          "required": [
            "path",
            "sha256"
          ]
        },
        "atlas": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "path": {
              "const": "assets/abedul-pintado/v0.1.0/manifest.json"
            },
            "sha256": {
              "type": "string",
              "pattern": "^[a-f0-9]{64}$"
            }
          },
          "required": [
            "path",
            "sha256"
          ]
        }
      },
      "required": [
        "bark",
        "foliage",
        "atlas"
      ]
    }
  },
  "$defs": {
    "parameters": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "base": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "height_m": {
              "type": "number",
              "const": 10
            },
            "base_radius_m": {
              "type": "number",
              "minimum": 0.12,
              "maximum": 0.22
            },
            "crown_base_ratio": {
              "type": "number",
              "minimum": 0.25,
              "maximum": 0.42
            },
            "primary_count": {
              "type": "integer",
              "minimum": 12,
              "maximum": 22
            },
            "secondary_count": {
              "type": "integer",
              "minimum": 3,
              "maximum": 6
            },
            "crown_radius_ratio": {
              "type": "number",
              "minimum": 0.17,
              "maximum": 0.26
            },
            "droop_ratio": {
              "type": "number",
              "minimum": 0.3,
              "maximum": 0.65
            },
            "irregularity": {
              "type": "number",
              "minimum": 0.05,
              "maximum": 0.25
            }
          },
          "required": [
            "height_m",
            "base_radius_m",
            "crown_base_ratio",
            "primary_count",
            "secondary_count",
            "crown_radius_ratio",
            "droop_ratio",
            "irregularity"
          ]
        },
        "canopy": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "group_length_m": {
              "type": "number",
              "minimum": 0.45,
              "maximum": 0.85
            },
            "groups_per_secondary": {
              "type": "integer",
              "minimum": 3,
              "maximum": 5
            }
          },
          "required": [
            "group_length_m",
            "groups_per_secondary"
          ]
        }
      },
      "required": [
        "base",
        "canopy"
      ]
    },
    "overrides": {
      "type": "object",
      "maxProperties": 0
    }
  }
}
