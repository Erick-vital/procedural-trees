{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "TreeBlueprint1.7: roble OF11 de copa libre",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "id",
    "version",
    "name",
    "description",
    "components",
    "parameters",
    "appearance",
    "editable_ranges",
    "default_profile",
    "profiles",
    "limits",
    "resources"
  ],
  "properties": {
    "schema_version": {
      "const": "1.7"
    },
    "id": {
      "const": "roble_copa_ancha"
    },
    "version": {
      "type": "string",
      "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$",
      "maxLength": 32
    },
    "name": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128
    },
    "description": {
      "type": "string",
      "maxLength": 1024
    },
    "components": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "base",
        "distribution",
        "representation"
      ],
      "properties": {
        "base": {
          "const": "oak-growth-central@0.1.0"
        },
        "distribution": {
          "const": "oak-central-groups@0.11.0"
        },
        "representation": {
          "const": "oak-central-crossed@0.11.0"
        }
      }
    },
    "parameters": {
      "$ref": "#/$defs/parameters"
    },
    "appearance": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "bark",
        "leaf"
      ],
      "properties": {
        "bark": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "color_rgba",
            "roughness",
            "metallic",
            "double_sided"
          ],
          "properties": {
            "color_rgba": {
              "type": "array",
              "minItems": 4,
              "maxItems": 4,
              "prefixItems": [
                {
                  "const": 1
                },
                {
                  "const": 1
                },
                {
                  "const": 1
                },
                {
                  "const": 1
                }
              ],
              "items": false
            },
            "roughness": {
              "type": "number",
              "const": 0.95
            },
            "metallic": {
              "type": "number",
              "const": 0
            },
            "double_sided": {
              "const": true
            }
          }
        },
        "leaf": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "color_rgba",
            "roughness",
            "metallic",
            "double_sided"
          ],
          "properties": {
            "color_rgba": {
              "type": "array",
              "minItems": 4,
              "maxItems": 4,
              "prefixItems": [
                {
                  "const": 1
                },
                {
                  "const": 1
                },
                {
                  "const": 1
                },
                {
                  "const": 1
                }
              ],
              "items": false
            },
            "roughness": {
              "type": "number",
              "const": 0.95
            },
            "metallic": {
              "type": "number",
              "const": 0
            },
            "double_sided": {
              "const": true
            }
          }
        }
      }
    },
    "editable_ranges": {
      "type": "object",
      "maxProperties": 0
    },
    "default_profile": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9_]{0,63}$"
    },
    "profiles": {
      "type": "object",
      "minProperties": 1,
      "maxProperties": 16,
      "propertyNames": {
        "pattern": "^[a-z][a-z0-9_]{0,63}$"
      },
      "additionalProperties": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "description",
          "overrides",
          "validation"
        ],
        "properties": {
          "description": {
            "type": "string",
            "maxLength": 512
          },
          "overrides": {
            "$ref": "#/$defs/overrides"
          },
          "validation": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "status",
              "evidence"
            ],
            "properties": {
              "status": {
                "enum": [
                  "reference_only",
                  "experimental",
                  "verified_cases"
                ]
              },
              "evidence": {
                "type": "array",
                "minItems": 1,
                "maxItems": 16,
                "uniqueItems": true,
                "items": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 256
                }
              }
            }
          }
        }
      }
    },
    "limits": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "triangles",
        "materials",
        "generation_seconds"
      ],
      "properties": {
        "triangles": {
          "type": "integer",
          "minimum": 1,
          "maximum": 6999
        },
        "materials": {
          "type": "integer",
          "const": 2
        },
        "generation_seconds": {
          "type": "number",
          "exclusiveMinimum": 0,
          "maximum": 120
        }
      }
    },
    "resources": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "foliage",
        "bark",
        "templates",
        "source_foliage",
        "source_layout"
      ],
      "properties": {
        "foliage": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "path",
            "sha256"
          ],
          "properties": {
            "path": {
              "const": "assets/roble-pintado/v0.3.0/foliage.png"
            },
            "sha256": {
              "type": "string",
              "pattern": "^[a-f0-9]{64}$"
            }
          }
        },
        "bark": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "path",
            "sha256"
          ],
          "properties": {
            "path": {
              "const": "assets/roble-pintado/v0.2.0/bark.png"
            },
            "sha256": {
              "type": "string",
              "pattern": "^[a-f0-9]{64}$"
            }
          }
        },
        "templates": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "path",
            "sha256"
          ],
          "properties": {
            "path": {
              "const": "assets/roble-pintado/v0.3.0/templates.json"
            },
            "sha256": {
              "type": "string",
              "pattern": "^[a-f0-9]{64}$"
            }
          }
        },
        "source_foliage": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "path",
            "sha256"
          ],
          "properties": {
            "path": {
              "const": "assets/roble-pintado/v0.2.0/foliage.png"
            },
            "sha256": {
              "type": "string",
              "pattern": "^[a-f0-9]{64}$"
            }
          }
        },
        "source_layout": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "path",
            "sha256"
          ],
          "properties": {
            "path": {
              "const": "assets/roble-pintado/v0.2.0/manifest.json"
            },
            "sha256": {
              "type": "string",
              "pattern": "^[a-f0-9]{64}$"
            }
          }
        }
      }
    }
  },
  "$defs": {
    "parameters": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "base",
        "canopy"
      ],
      "properties": {
        "base": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "height_m",
            "preset"
          ],
          "properties": {
            "height_m": {
              "type": "integer",
              "const": 12
            },
            "preset": {
              "type": "string",
              "const": "presets/oak-growth/0.5.0/maduro.json"
            }
          }
        },
        "canopy": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "tree_groups",
            "span_over_height",
            "core_radius_over_height"
          ],
          "properties": {
            "tree_groups": {
              "type": "integer",
              "const": 216
            },
            "span_over_height": {
              "type": "number",
              "const": 0.1
            },
            "core_radius_over_height": {
              "type": "number",
              "const": 0.3
            }
          }
        }
      }
    },
    "overrides": {
      "type": "object",
      "maxProperties": 0
    }
  }
}
