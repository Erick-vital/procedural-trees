{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "version",
    "seed",
    "group_count",
    "leaf_length_m",
    "shell_depth_m",
    "twig_radius_m",
    "tip_radius_ratio",
    "profile_width_scale",
    "region_weights"
  ],
  "properties": {
    "version": {
      "enum": [
        "foliage-canopy-0.1.0",
        "foliage-canopy-0.1.1"
      ]
    },
    "seed": {
      "type": "integer",
      "minimum": 0,
      "maximum": 2147483646
    },
    "group_count": {
      "type": "integer",
      "minimum": 24,
      "maximum": 360
    },
    "leaf_length_m": {
      "type": "number",
      "minimum": 0.2,
      "maximum": 1
    },
    "shell_depth_m": {
      "type": "number",
      "minimum": 0.02,
      "maximum": 0.3
    },
    "twig_radius_m": {
      "type": "number",
      "minimum": 0.008,
      "maximum": 0.03
    },
    "tip_radius_ratio": {
      "type": "number",
      "minimum": 0.2,
      "maximum": 0.5
    },
    "profile_width_scale": {
      "type": "number",
      "minimum": 0.85,
      "maximum": 1.15
    },
    "region_weights": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "north",
        "east",
        "south",
        "west"
      ],
      "properties": {
        "north": {
          "type": "number",
          "minimum": 0,
          "maximum": 1
        },
        "east": {
          "type": "number",
          "minimum": 0,
          "maximum": 1
        },
        "south": {
          "type": "number",
          "minimum": 0,
          "maximum": 1
        },
        "west": {
          "type": "number",
          "minimum": 0,
          "maximum": 1
        }
      }
    }
  }
}
