{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "TreeSpec v1: roble en Geometry Nodes",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "algorithm",
    "algorithm_version",
    "seed",
    "parameters"
  ],
  "properties": {
    "schema_version": {
      "const": "1.0"
    },
    "algorithm": {
      "const": "oak_geometry_nodes"
    },
    "algorithm_version": {
      "enum": [
        "0.1.0",
        "0.2.0",
        "0.2.1",
        "0.3.0",
        "0.4.0",
        "0.4.1"
      ]
    },
    "seed": {
      "type": "integer",
      "minimum": 0,
      "maximum": 2147483647
    },
    "parameters": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "height_m",
        "base_radius_m",
        "curvature",
        "primary_branches",
        "max_depth",
        "branch_length_ratio",
        "inclination_deg",
        "asymmetry",
        "foliage_density",
        "foliage_scale_m"
      ],
      "properties": {
        "height_m": {
          "type": "number",
          "minimum": 2,
          "maximum": 20
        },
        "base_radius_m": {
          "type": "number",
          "minimum": 0.05,
          "maximum": 1
        },
        "curvature": {
          "type": "number",
          "minimum": 0,
          "maximum": 0.3,
          "description": "Desplazamiento lateral relativo a altura"
        },
        "primary_branches": {
          "type": "integer",
          "minimum": 1,
          "maximum": 12
        },
        "max_depth": {
          "type": "integer",
          "minimum": 1,
          "maximum": 2
        },
        "branch_length_ratio": {
          "type": "number",
          "minimum": 0.1,
          "maximum": 0.6
        },
        "inclination_deg": {
          "type": "number",
          "minimum": 10,
          "maximum": 80,
          "description": "\u00c1ngulo desde la vertical"
        },
        "asymmetry": {
          "type": "number",
          "minimum": 0,
          "maximum": 1
        },
        "foliage_density": {
          "type": "number",
          "minimum": 0,
          "maximum": 1,
          "description": "0.1/0.2: masas por extremo; 0.3: por tramo distal; 0.4: control de cantidad por longitud/nivel (m\u00e1ximos tronco/primaria/secundaria 2/3/2); 0 sin follaje; 0.4.1: cantidad por longitud y radio, con secundarias intermedias sin hojas"
        },
        "foliage_scale_m": {
          "type": "number",
          "minimum": 0.2,
          "maximum": 3
        }
      }
    }
  }
}
